APP_ID="org.outershell.Plaintext"
APP_NAME="Plaintext"
APP_STAGE_NAME="Plaintext"
XCODE_PROJECT="Plaintext.xcodeproj"
XCODE_SCHEME="Plaintext"
XCODE_PRODUCT_NAME="Plaintext"
BUNDLE_ARCHIVE_SCRIPT="Scripts/archive_plaintext_bundle.sh"
BUNDLE_ARCHIVE_STEM="PlaintextContent.bundle"
BACKEND_SOURCE="Backend/main.c"
BACKEND_EXECUTABLE_NAME="PlaintextBackend"
BACKEND_CFLAGS="-std=gnu17 -Os -ffunction-sections -fdata-sections -flto"
BACKEND_LDFLAGS="-ldl -lpthread -lm"
DEFAULT_DEPLOY_SCOPE="user"
ROOT_ONLY="false"
